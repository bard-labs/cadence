# Copy to deploy/.env.prod on the server and fill in values.
# Never commit deploy/.env.prod.

CADENCE_PUBLIC_HOST=cadence.bardiamardan.xyz
CADENCE_PUBLIC_ORIGIN=https://cadence.bardiamardan.xyz
CADENCE_PUBLIC_WS_URL=wss://cadence.bardiamardan.xyz/ws

# Comma-separated browser origins (LAN + public)
CADENCE_CORS_ORIGIN=http://192.168.100.100,https://cadence.bardiamardan.xyz
# false so http://192.168.100.100 login cookies work
CADENCE_COOKIE_SECURE=false

# Strong random secrets (openssl rand -base64 32)
CADENCE_DB_PASSWORD=change-me-db
CADENCE_S3_ACCESS_KEY=cadence
CADENCE_S3_SECRET_KEY=change-me-minio-secret-at-least-16-chars

CADENCE_MAX_UPLOAD_MB=50
