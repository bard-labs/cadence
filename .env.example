# Runtime mode: development | production (production enforces secure cookies + https origin)
CADENCE_ENV=development

# API
CADENCE_HTTP_ADDR=:8080
# The web app's origin. Used for CORS, the WebSocket origin check and CSRF checks.
CADENCE_CORS_ORIGIN=http://localhost:3000
# Set true only behind a reverse proxy you control (trusts X-Forwarded-For).
CADENCE_TRUST_PROXY=false
# Must be true in production (HTTPS only cookies).
CADENCE_COOKIE_SECURE=false

# Postgres
# Port 5433 = Docker Postgres (see deploy/docker-compose.yml). Use 5432 only if you have no local Postgres.
CADENCE_DATABASE_URL=postgres://cadence:cadence@localhost:5433/cadence?sslmode=disable

# Redis
CADENCE_REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible)
CADENCE_S3_ENDPOINT=localhost:9000
# Host browsers use to reach storage (presigned uploads are signed for this host).
CADENCE_S3_PUBLIC_ENDPOINT=localhost:9000
CADENCE_S3_ACCESS_KEY=cadence
CADENCE_S3_SECRET_KEY=cadence-secret
CADENCE_S3_BUCKET=cadence-tracks
CADENCE_S3_USE_SSL=false
CADENCE_S3_PUBLIC_URL=http://localhost:9000/cadence-tracks
CADENCE_MAX_UPLOAD_MB=50

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
