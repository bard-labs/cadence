# API
CADENCE_HTTP_ADDR=:8080
CADENCE_SESSION_SECRET=change-me-in-production-use-32-bytes-min
CADENCE_CORS_ORIGIN=http://localhost:3000

# Postgres
CADENCE_DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence?sslmode=disable

# Redis
CADENCE_REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible)
CADENCE_S3_ENDPOINT=localhost:9000
CADENCE_S3_ACCESS_KEY=cadence
CADENCE_S3_SECRET_KEY=cadence-secret
CADENCE_S3_BUCKET=cadence-tracks
CADENCE_S3_USE_SSL=false
CADENCE_S3_PUBLIC_URL=http://localhost:9000/cadence-tracks

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
